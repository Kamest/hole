#!/usr/sbin/nft -f
# In-place update of a running gateway; the input and postrouting chains never change at runtime.
flush chain inet hole forward

table inet hole {
    set b_84f893fe86 {
        type ipv4_addr
    }
    set r_3c306031fd {
        type ipv4_addr
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        meta nfproto ipv6 drop
        ct state established,related accept
        ip daddr @b_84f893fe86 tcp dport { 22, 443 } accept
        ip daddr @b_84f893fe86 udp dport { 22, 443 } accept
        ip daddr @r_3c306031fd tcp dport { 80 } accept
        ip daddr @r_3c306031fd udp dport { 80 } accept
        counter limit rate 10/minute log prefix "hole-denied " level info
    }
}
