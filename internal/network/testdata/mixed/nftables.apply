#!/usr/sbin/nft -f
# In-place update of a running gateway; the input and postrouting chains never change at runtime.
flush chain inet hole forward

table inet hole {
    set b_84f893fe86 {
        type ipv4_addr
    }
    set b_a80464e5d8_static {
        type ipv4_addr
        flags interval
        # auto-merge collapses an address already covered by a CIDR in the same set; without it
        # nft rejects the whole ruleset with "conflicting intervals" and the gateway never starts.
        auto-merge
        elements = { 10.0.0.5 }
    }
    set b_3e9eb28d23 {
        type ipv4_addr
    }
    set b_19068b7059 {
        type ipv4_addr
    }
    set b_8a8abf36a1_static {
        type ipv4_addr
        flags interval
        # auto-merge collapses an address already covered by a CIDR in the same set; without it
        # nft rejects the whole ruleset with "conflicting intervals" and the gateway never starts.
        auto-merge
        elements = { 192.168.1.0/24 }
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        meta nfproto ipv6 drop
        ct state established,related accept
        ip daddr {HOST_GATEWAY_IP} tcp dport { 5432 } accept
        ip daddr {HOST_GATEWAY_IP} udp dport { 5432 } accept
        ip daddr @b_84f893fe86 tcp dport { 22, 443 } accept
        ip daddr @b_84f893fe86 udp dport { 22, 443 } accept
        ip daddr @b_a80464e5d8_static tcp dport { 22, 2222 } accept
        ip daddr @b_a80464e5d8_static udp dport { 22, 2222 } accept
        ip daddr @b_3e9eb28d23 tcp dport { 80, 443 } accept
        ip daddr @b_3e9eb28d23 udp dport { 80, 443 } accept
        ip daddr @b_19068b7059 tcp dport { 5432 } accept
        ip daddr @b_19068b7059 udp dport { 5432 } accept
        ip daddr @b_8a8abf36a1_static tcp dport { 8080 } accept
        ip daddr @b_8a8abf36a1_static udp dport { 8080 } accept
        counter limit rate 10/minute log prefix "hole-denied " level info
    }
}
