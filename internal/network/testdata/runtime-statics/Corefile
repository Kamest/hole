health.hole.internal:53 {
    template IN A health.hole.internal {
        answer "{{ .Name }} 0 IN A 127.0.0.1"
    }
    template IN AAAA health.hole.internal {
        rcode NOERROR
    }
    template IN TXT health.hole.internal {
        answer "{{ .Name }} 0 IN TXT \"d93fcf591dab\""
    }
    errors
}

. {
    template IN ANY . {
        rcode NXDOMAIN
    }
    log
    errors
}
